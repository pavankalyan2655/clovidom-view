{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install frontend dependencies",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"npm.cmd install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build auth UI",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"npm.cmd run build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Start auth UI dev server",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"npm.cmd run dev -- --host localhost"
			],
			"isBackground": true,
			"problemMatcher": [
				"$vite"
			],
			"group": "build"
		}
	]
}